# ═══════════════════════════════════════
# OGPHOTOS — Variables de entorno
# ═══════════════════════════════════════
# IMPORTANTE: Este archivo es solo una PLANTILLA
# Nunca subas el archivo .env real a GitHub
# Configura estas variables en el dashboard de Netlify:
# Site Settings → Environment Variables

# ── Gemini AI (Google AI Studio) ──
# Obtener en: aistudio.google.com → Get API Key
GEMINI_API_KEY=tu_api_key_aqui

# ── Firebase (cuando lo configures) ──
# Obtener en: console.firebase.google.com → Proyecto → Configuración → Cuentas de servicio
# Pegar el JSON completo como string
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}

# ── Cloudbeds — Casa Nawalli Puerto Vallarta ──
# Obtener en: Cloudbeds → Apps & Marketplace → API → Crear aplicación
CLOUDBEDS_CLIENT_ID_NAWALLI=
CLOUDBEDS_CLIENT_SECRET_NAWALLI=

# ── Cloudbeds — Amari Sayulita ──
CLOUDBEDS_CLIENT_ID_AMARI=
CLOUDBEDS_CLIENT_SECRET_AMARI=

# ── General ──
NODE_ENV=production
